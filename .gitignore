# ===========================================================================
# Repository ignore rules
#
# Grouped by purpose. Add new patterns to the closest group instead of
# appending at the end. Keep this file readable: one comment per group.
#
# Never ignore:
#   * package-lock.json (reproducible installs depend on it)
#   * database migrations (the schema history must ship with the code)
#   * docs, tests, or fixtures that the product needs to build and run
#
# Anything ignored here is local state. If a file must reach another machine
# or the buyer, it belongs in git (or in a release artifact), not in an ignore
# rule.
# ===========================================================================

# --- Secrets and local environment -----------------------------------------
# Real environment files never leave the developer machine.
.env
.env.*
# Only documented, secret-free templates are tracked.
!.env.example
!.env.*.example
# Key material and certificates. Generate test fixtures at runtime instead of
# committing them.
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.p8
*.mobileprovision
# direnv and other shell-local overrides
.envrc.local
.direnv/

# --- Local agent and handover scratch space --------------------------------
# Session briefs and working notes stay on the developer machine.
.brief/

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.npm/

# --- Build output: web -----------------------------------------------------
.next/
out/
.vercel/
.turbo/
dist/
build/
web-build/
*.tsbuildinfo
.tgz

# --- Build output: Expo / React Native -------------------------------------
.expo/
.expo-shared/
.metro-health-check*
# `expo prebuild` generates these projects from app.json; they are not source.
/apps/mobile/android/
/apps/mobile/ios/
android/.gradle/
android/local.properties
android/app/build/
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
*.orig.*
*.hprof

# --- Test output and coverage ---------------------------------------------
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
.playwright/
junit.xml
junit*.xml
*.lcov

# --- Local runtime data, uploads, and backups ------------------------------
# Docker Compose volumes and local service state. The schema and migrations
# stay in git; this is data only.
/.data/
/.volumes/
/.local/
/pgdata/
/redisdata/
/storage/
/uploads/
/backups/
*.dump
*.sql.gz
*.bak
*.backup
*.db
*.db-journal
*.sqlite
*.sqlite3
# If a test needs a database fixture, create it inside the test at runtime.
# Do not check database files into git.

# --- Local Compose overrides ----------------------------------------------
# Personal port or volume tweaks belong here, never in the shared compose file.
/compose.override.yaml
/compose.override.yml
/docker-compose.override.yaml
/docker-compose.override.yml

# --- Logs, caches, and temporary files ------------------------------------
*.log
logs/
tmp/
temp/
*.pid
.eslintcache
.stylelintcache
.cache/

# --- Operating system junk ------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editor and IDE state -------------------------------------------------
.idea/
.vscode/*
# Recommended extensions are useful to everyone and contain no machine state.
!.vscode/extensions.json
*.swp
*.swo
*~
.history/
