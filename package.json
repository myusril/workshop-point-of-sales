{
  "name": "workshop-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Workshop POS — web back-office and offline-capable mobile point of sale for vehicle workshops.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev --workspace @workshop-pos/web -- --hostname 127.0.0.1",
    "build": "npm run build --workspace @workshop-pos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e:web": "npm run test:e2e:web --workspace @workshop-pos/web",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "license:report": "bash scripts/license-report.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1"
  }
}
