# Local configuration template. Copy to .env and keep .env out of git.
# Every value is a disposable local placeholder, not a production credential.

# Node runtime mode used by the app and Compose services.
NODE_ENV=development
# Public base URL of the web app in a browser.
APP_URL=http://localhost:3000
# Better Auth cookie-signing/encryption secret. Generate a real value with:
#   openssl rand -base64 32
# This placeholder is disposable local configuration, never a production secret.
BETTER_AUTH_SECRET=replace-me-openssl-rand-base64-32-characters
# Hostname Caddy serves; leave as localhost for local use.
APP_DOMAIN=localhost
# PostgreSQL role created by the dev Compose stack.
POSTGRES_USER=workshop
# Disposable password for the local database only.
POSTGRES_PASSWORD=workshop
# Application database name.
POSTGRES_DB=workshop_pos
# Connection string for host-run tooling (the dev stack publishes 55432).
# The production Compose stack builds its own in-network URL from POSTGRES_*.
DATABASE_URL=postgresql://workshop:workshop@localhost:55432/workshop_pos

# --- Optional encrypted backup sidecar -------------------------------------
# Passphrase for AES-256-CBC backups. Generate a long random value, store it in
# the buyer's secret manager, and keep it out of this file. Losing it makes
# every encrypted dump unrecoverable. Required only when the `backup` Compose
# profile is enabled; the sidecar fails closed when it is empty.
BACKUP_PASSPHRASE=
# Preferred alternative: path inside the container to a mounted passphrase file
# (for example a Compose secret at /run/secrets/backup_passphrase). When set and
# readable, it takes precedence over BACKUP_PASSPHRASE.
BACKUP_PASSPHRASE_FILE=
# Optional PostgreSQL passfile path inside the container. When set, the
# entrypoint unsets PGPASSWORD before pg_dump. The shipped Compose service still
# injects POSTGRES_PASSWORD as PGPASSWORD, so use a service override (and a
# mounted passfile) if the password must not appear in `docker inspect`.
PGPASSFILE=
# Seconds between backup runs. 900 preserves the 15-minute RPO target.
BACKUP_INTERVAL_SECONDS=900
# Days to keep encrypted dumps on the backup volume before pruning.
BACKUP_RETENTION_DAYS=30
