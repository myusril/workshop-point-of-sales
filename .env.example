# Local configuration template. Copy to .env and keep .env out of git.
# Every value is a disposable local placeholder, not a production credential.

# Node runtime mode used by the app and Compose services.
NODE_ENV=development
# Public base URL of the web app in a browser.
APP_URL=http://localhost:3000
# Hostname Caddy serves; leave as localhost for local use.
APP_DOMAIN=localhost
# PostgreSQL role created by the dev Compose stack.
POSTGRES_USER=workshop
# Disposable password for the local database only.
POSTGRES_PASSWORD=workshop
# Application database name.
POSTGRES_DB=workshop_pos
# Connection string for host-run tooling (the dev stack publishes 55432).
# The production Compose stack builds its own in-network URL from POSTGRES_*.
DATABASE_URL=postgresql://workshop:workshop@localhost:55432/workshop_pos
