    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
